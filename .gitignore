# --- Data: never commit raw or derived parquet (GBs) ------------------------
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep
# ...but a tiny committed sample is allowed for reproducibility
!data/**/sample_*.csv
!data/**/sample_*.parquet

# --- Models & reports -------------------------------------------------------
# Committed on purpose: the saved models and report artifacts ARE the submitted
# results, and all of them are small (the largest, reports/geojson, is ~25 MB).
# Parquet checksum noise (*.crc, _SUCCESS) is still excluded globally below.

# --- Spark / Ivy ------------------------------------------------------------
.ivy2/
spark-warehouse/
metastore_db/
derby.log
*.crc
_SUCCESS
checkpoint/
**/_checkpoints/

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# --- Runtime markers --------------------------------------------------------
.stream_ready

# --- Editors / OS -----------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# --- Launcher scratch -------------------------------------------------------
*.log

# --- Local working notes, not part of the submission ------------------------
CLAUDE_CODE_PROMPT.md
QA_PREP.md
